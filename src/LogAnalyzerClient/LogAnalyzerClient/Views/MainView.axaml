<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:vm="using:LogAnalyzerClient.ViewModels"
                xmlns:models="using:LogAnalyzerClient.Models"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                x:Class="LogAnalyzerClient.Views.MainView"
                x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File(_F)">
                <MenuItem Header="Connect...(_C)" Command="{Binding ConnectCommand}" />
                <MenuItem Header="Refresh(_R)" Command="{Binding RefreshCommand}" />
                <Separator />
                <MenuItem Header="Exit(_E)" Name="ExitMenuItem" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="About(_A)" Command="{Binding AboutCommand}" />
        </Menu>

        <Border DockPanel.Dock="Bottom"
                Padding="10"
                BorderThickness="1,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                <TextBlock Text="[Status] " />
                <TextBlock Text="{Binding ConnectStatus}" />
                <TextBlock Text="Agent address: " />
                <TextBlock Text="{Binding CurrentAddress}" />
                <TextBlock Text="; Current Directory: " />
                <TextBlock Text="{Binding DirectoryPath}" />
            </StackPanel>
        </Border>

        <Grid Margin="16" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Spacing="4"
            >
                <TextBlock Classes="TitleText" Text="LogAnalyzerClient" />
                <TextBlock Classes="SubtleText" Text="GUI remote client of LogAnalyzer." />
            </StackPanel>

            <Border
                Grid.Row="1"
                Grid.Column="0"
                Classes="Card"
            >
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5" RowSpacing="5">
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Directory Path" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding DirectoryPath, Mode=OneWayToSource}"
                             PlaceholderText="Input the directory path on the node" />
                    <Button Grid.Row="0" Grid.Column="2" Classes="SecondaryButton" Content="Change Directory" Command="{Binding ChangeDirectoryCommand}" />
                    <Button Grid.Row="0" Grid.Column="3" Classes="SecondaryButton" Content="Refresh" Command="{Binding RefreshCommand}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,10,0,10" ColumnSpacing="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MaxWidth="360" MinWidth="50" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Classes="Card">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="8">
                            <TextBlock Classes="SectionTitle" Text="Log Files" />
                            <TextBlock Classes="SubtleText" Text="Supports multiple selection (hold Ctrl). Right-click to view analysis results for the currently selected files." TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <TextBlock Grid.Column="0" Margin="0,0,5,0" VerticalAlignment="Center" Text="DoP" />
                                <TextBox Name="DegreeTextBox"
                                         Grid.Column="1"
                                         Classes="NumericInput"
                                         Text="{Binding DegreeOfParallelismText}"
                                         PlaceholderText="Degree of Parallelism" />
                                <TextBlock Grid.Column="2" Margin="10,0,5,0" VerticalAlignment="Center" Text="Analyze" />
                                <Button Grid.Column="3" Content="Selected" Command="{Binding AnalyzeSelectedFilesCommand}" />
                                <Button Grid.Column="4" Margin="5,0,0,0" Content="All" Command="{Binding AnalyzeAllCommand}" />
                                <!-- TODO: T4.1 -->
                                <!-- Add "All" button -->
                            </Grid>
                        </StackPanel>

                        <ListBox Name="LogFileListBox"
                                 Classes="FileList"
                                 Margin="0,12,0,0"
                                 ItemsSource="{Binding LogFiles, Mode=OneWay}"
                                 SelectedItem="{Binding SelectedLogFile, Mode=OneWayToSource}"
                                 SelectionMode="Multiple"
                                 SelectionChanged="LogFileListBox_SelectionChanged"
                                 >
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Analyze File(_A)" Command="{Binding AnalyzeRightClickedFileCommand}"/>
                                    <MenuItem Header="View Analysis Results(_V)" Command="{Binding GetAnalysisResultCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:LogFileItem">
                                    <TextBlock Text="{Binding FileName, Mode=OneWay}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Classes="Card">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="5">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15">
                            <TextBlock Classes="SectionTitle" Text="Analysis Result" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Classes="SubtleText"
                                   Text="Analysis results. Each line is a single log entry."
                                   TextWrapping="Wrap" />

                        <!-- T5.1: 查询/排序工具条 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <TextBox Width="220"
                                     VerticalAlignment="Center"
                                     Watermark="Filter: severity=error, event=call, gateway ..."
                                     Text="{Binding FilterText, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center" Text="Sort:" />
                            <ComboBox ItemsSource="{Binding SortKeys}"
                                      SelectedItem="{Binding SortKey, Mode=TwoWay}"
                                      MinWidth="100" />
                            <ToggleButton Content="Desc"
                                          IsChecked="{Binding SortDescending, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center"
                                       Classes="SubtleText"
                                       Text="{Binding DisplayRows.Count, StringFormat='{}{0} rows'}" />
                        </StackPanel>

                        <!-- T5.1: 表格视图（等级高亮） -->
                        <DataGrid Name="ResultDataGrid"
                                Grid.Row="2"
                                LoadingRow="ResultDataGrid_LoadingRow"
                                ItemsSource="{Binding DisplayRows, Mode=OneWay}"
                                IsReadOnly="True"
                                GridLinesVisibility="Horizontal"
                                HeadersVisibility="Column"
                                AutoGenerateColumns="False"
                                CanUserReorderColumns="True"
                                CanUserResizeColumns="True"
                                CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Line" Binding="{Binding LineNo}" Width="60" />
                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="170" />
                                <DataGridTextColumn Header="Pod" Binding="{Binding PodName}" Width="120" />
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80" />
                                <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="80" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
