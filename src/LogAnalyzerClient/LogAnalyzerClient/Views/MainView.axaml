<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:vm="using:LogAnalyzerClient.ViewModels"
                xmlns:models="using:LogAnalyzerClient.Models"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                x:Class="LogAnalyzerClient.Views.MainView"
                x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File(_F)">
                <MenuItem Header="Connect...(_C)" Command="{Binding ConnectCommand}" />
                <MenuItem Header="Refresh(_R)" Command="{Binding RefreshCommand}" />
                <Separator />
                <MenuItem Header="Exit(_E)" Name="ExitMenuItem" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="About(_A)" Command="{Binding AboutCommand}" />
        </Menu>

        <Border DockPanel.Dock="Bottom"
                Padding="10"
                BorderThickness="1,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                <TextBlock Text="[Status] " />
                <TextBlock Text="{Binding ConnectStatus}" />
                <TextBlock Text="Agent address: " />
                <TextBlock Text="{Binding CurrentAddress}" />
                <TextBlock Text="; Current Directory: " />
                <TextBlock Text="{Binding DirectoryPath}" />
            </StackPanel>
        </Border>

        <Grid Margin="16" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Spacing="4"
            >
                <TextBlock Classes="TitleText" Text="LogAnalyzerClient" />
                <TextBlock Classes="SubtleText" Text="GUI remote client of LogAnalyzer." />
            </StackPanel>

            <Border
                Grid.Row="1"
                Grid.Column="0"
                Classes="Card"
            >
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5" RowSpacing="5">
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Directory Path" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding DirectoryPath, Mode=OneWayToSource}"
                             PlaceholderText="Input the directory path on the node" />
                    <Button Grid.Row="0" Grid.Column="2" Classes="SecondaryButton" Content="Change Directory" Command="{Binding ChangeDirectoryCommand}" />
                    <Button Grid.Row="0" Grid.Column="3" Classes="SecondaryButton" Content="Refresh" Command="{Binding RefreshCommand}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,10,0,10" ColumnSpacing="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MaxWidth="360" MinWidth="50" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Classes="Card">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="8">
                            <TextBlock Classes="SectionTitle" Text="Log Files" />
                            <TextBlock Classes="SubtleText" Text="Supports multiple selection (hold Ctrl). Right-click to view analysis results for the currently selected files." TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Margin="0,0,5,0" VerticalAlignment="Center" Text="DoP" />
                                <TextBox Name="DegreeTextBox"
                                         Grid.Column="1"
                                         Classes="NumericInput"
                                         Text="{Binding DegreeOfParallelismText}"
                                         PlaceholderText="Degree of Parallelism" />
                                <TextBlock Grid.Column="2" Margin="10,0,5,0" VerticalAlignment="Center" Text="Analyze" />
                                <Button Grid.Column="3" Content="Selected" Command="{Binding AnalyzeSelectedFilesCommand}" />
                                <Button Grid.Column="4" Content="All" Command="{Binding AnalyzeAllCommand}" />
                            </Grid>
                        </StackPanel>

                        <ListBox Name="LogFileListBox"
                                 Classes="FileList"
                                 Margin="0,12,0,0"
                                 ItemsSource="{Binding LogFiles, Mode=OneWay}"
                                 SelectedItem="{Binding SelectedLogFile, Mode=OneWayToSource}"
                                 SelectionMode="Multiple"
                                 SelectionChanged="LogFileListBox_SelectionChanged"
                                 >
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Analyze File(_A)" Command="{Binding AnalyzeRightClickedFileCommand}"/>
                                    <MenuItem Header="View Analysis Results(_V)" Command="{Binding GetAnalysisResultCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:LogFileItem">
                                    <TextBlock Text="{Binding FileName, Mode=OneWay}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Classes="Card">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="6">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15">
                            <TextBlock Classes="SectionTitle" Text="Analysis Result" VerticalAlignment="Center" />
                            <Button Classes="SecondaryButton" Content="Statistics" Command="{Binding GetStatisticsCommand}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Classes="SubtleText"
                                   Text="Right-click a file and choose View Analysis Results, or use the query panel below."
                                   TextWrapping="Wrap" />

                        <Border Grid.Row="2"
                                Padding="8"
                                BorderThickness="1"
                                CornerRadius="6"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                            <Grid RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,90,Auto,90,Auto,110,Auto,*">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Event" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding EventTypeOptions}" SelectedItem="{Binding QueryEventType}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Severity" />
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding QuerySeverity}" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Service" />
                                    <TextBox Grid.Column="5" Text="{Binding QueryService}" />
                                    <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="RequestId" />
                                    <TextBox Grid.Column="7" Text="{Binding QueryRequestId}" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,110,Auto,110,Auto,90,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Start" />
                                    <TextBox Grid.Column="1" Text="{Binding QueryStartTime}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="End" />
                                    <TextBox Grid.Column="3" Text="{Binding QueryEndTime}" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Sort" />
                                    <ComboBox Grid.Column="5" ItemsSource="{Binding SortByOptions}" SelectedItem="{Binding SortBy}" />
                                    <CheckBox Grid.Column="6" Content="Asc" IsChecked="{Binding SortAscending}" VerticalAlignment="Center" />
                                    <Button Grid.Column="7" Content="Query" Command="{Binding QueryCommand}" />
                                    <Button Grid.Column="8" Content="Clear" Command="{Binding ClearQueryCommand}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="3"
                                   Classes="SubtleText"
                                   Text="{Binding ResultMessage}"
                                   TextWrapping="Wrap" />

                        <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid ColumnDefinitions="50,180,120,76,76,300,110,80,70,170,80,200,220">
                                    <TextBlock Grid.Column="0" Text="LineNo" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Timestamp" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="PodName" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Severity" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="EventType" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="RequestId" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="TargetService" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="7" Text="DurationMs" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="8" Text="Method" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="9" Text="Path" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="10" Text="StatusCode" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="11" Text="ExceptionName" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="12" Text="ExceptionMessage" FontWeight="SemiBold" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ResultEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:LogEntryRow">
                                            <Grid ColumnDefinitions="50,180,120,76,76,300,110,80,70,170,80,200,220">
                                                <TextBlock Grid.Column="0" Text="{Binding LineNo}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Timestamp}" />
                                                <TextBlock Grid.Column="2" Text="{Binding PodName}" />
                                                <Border Grid.Column="3" Classes="severityBadge" Background="{Binding SeverityBrush}">
                                                    <TextBlock Text="{Binding Severity}" Foreground="White" />
                                                </Border>
                                                <TextBlock Grid.Column="4" Text="{Binding EventType}" />
                                                <TextBlock Grid.Column="5" Text="{Binding RequestId}" />
                                                <TextBlock Grid.Column="6" Text="{Binding TargetService}" />
                                                <TextBlock Grid.Column="7" Text="{Binding DurationMs}" />
                                                <TextBlock Grid.Column="8" Text="{Binding Method}" />
                                                <TextBlock Grid.Column="9" Text="{Binding Path}" />
                                                <TextBlock Grid.Column="10" Text="{Binding StatusCode}" />
                                                <TextBlock Grid.Column="11" Text="{Binding ExceptionName}" />
                                                <TextBlock Grid.Column="12" Text="{Binding ExceptionMessage}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
