<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:vm="using:LogAnalyzerClient.ViewModels"
                xmlns:models="using:LogAnalyzerClient.Models"
                xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
                xmlns:converters="using:LogAnalyzerClient.Converters"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                x:Class="LogAnalyzerClient.Views.MainView"
                x:DataType="vm:MainViewModel">
                
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <converters:SeverityBrushConverter x:Key="SeverityBrushConverter" />
    </UserControl.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File(_F)">
                <MenuItem Header="Connect...(_C)" Command="{Binding ConnectCommand}" />
                <MenuItem Header="Refresh(_R)" Command="{Binding RefreshCommand}" />
                <Separator />
                <MenuItem Header="Exit(_E)" Name="ExitMenuItem" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="About(_A)" Command="{Binding AboutCommand}" />
        </Menu>

        <Border DockPanel.Dock="Bottom"
                Padding="10"
                BorderThickness="1,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                <TextBlock Text="[Status] " />
                <TextBlock Text="{Binding ConnectStatus}" />
                <TextBlock Text="Agent address: " />
                <TextBlock Text="{Binding CurrentAddress}" />
                <TextBlock Text="; Current Directory: " />
                <TextBlock Text="{Binding DirectoryPath}" />
            </StackPanel>
        </Border>

        <Grid Margin="16" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Spacing="4"
            >
                <TextBlock Classes="TitleText" Text="LogAnalyzerClient" />
                <TextBlock Classes="SubtleText" Text="GUI remote client of LogAnalyzer." />
            </StackPanel>

            <Border
                Grid.Row="1"
                Grid.Column="0"
                Classes="Card"
            >
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5" RowSpacing="5">
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Directory Path" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding DirectoryPath, Mode=OneWayToSource}"
                             PlaceholderText="Input the directory path on the node" />
                    <Button Grid.Row="0" Grid.Column="2" Classes="SecondaryButton" Content="Change Directory" Command="{Binding ChangeDirectoryCommand}" />
                    <Button Grid.Row="0" Grid.Column="3" Classes="SecondaryButton" Content="Refresh" Command="{Binding RefreshCommand}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,10,0,10" ColumnSpacing="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MaxWidth="360" MinWidth="50" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Classes="Card">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="8">
                            <TextBlock Classes="SectionTitle" Text="Log Files" />
                            <TextBlock Classes="SubtleText" Text="Supports multiple selection (hold Ctrl). Right-click to view analysis results for the currently selected files." TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="5">
                                <TextBlock Grid.Column="0" Margin="0,0,5,0" VerticalAlignment="Center" Text="DoP" />
                                <TextBox Name="DegreeTextBox"
                                         Grid.Column="1"
                                         Classes="NumericInput"
                                         Text="{Binding DegreeOfParallelismText}"
                                         PlaceholderText="Degree of Parallelism" />
                                <TextBlock Grid.Column="2" Margin="10,0,5,0" VerticalAlignment="Center" Text="Analyze" />
                                <Button Grid.Column="3" Content="Selected" Command="{Binding AnalyzeSelectedFilesCommand}" />
                                <Button Grid.Column="4" Margin="5,0,0,0" Content="All" Command="{Binding AnalyzeAllCommand}" />
                                <!-- Add "All" button -->
                            </Grid>
                        </StackPanel>

                        <ListBox Name="LogFileListBox"
                                 Classes="FileList"
                                 Margin="0,12,0,0"
                                 ItemsSource="{Binding LogFiles, Mode=OneWay}"
                                 SelectedItem="{Binding SelectedLogFile, Mode=OneWayToSource}"
                                 SelectionMode="Multiple"
                                 SelectionChanged="LogFileListBox_SelectionChanged"
                                 >
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Analyze File(_A)" Command="{Binding AnalyzeRightClickedFileCommand}"/>
                                    <MenuItem Header="View Analysis Results(_V)" Command="{Binding GetAnalysisResultCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:LogFileItem">
                                    <TextBlock Text="{Binding FileName, Mode=OneWay}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Classes="Card">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="5">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15">
                            <TextBlock Classes="SectionTitle" Text="Analysis Result" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="6">
                            <Grid ColumnDefinitions="*,*,*,*,Auto,Auto,Auto">
                                <TextBox Grid.Column="0" Watermark="Pod name"
                                        Text="{Binding QueryPodName, Mode=TwoWay}" />
                                <TextBox Grid.Column="1" Watermark="Request ID"
                                        Text="{Binding QueryRequestId, Mode=TwoWay}" />
                                <TextBox Grid.Column="2" Watermark="Info / Warning / Error"
                                        Text="{Binding QuerySeverity, Mode=TwoWay}" />
                                <TextBox Grid.Column="3" Watermark="Call / Request / Internal"
                                        Text="{Binding QueryEventType, Mode=TwoWay}" />
                                <ComboBox Grid.Column="4" ItemsSource="{Binding SortKeys}"
                                        SelectedItem="{Binding SortKey, Mode=TwoWay}" />
                                <CheckBox Grid.Column="5" Content="Descending"
                                        IsChecked="{Binding SortDescending, Mode=TwoWay}" />
                                <Button Grid.Column="6" Content="Query" Command="{Binding QueryCommand}" />
                            </Grid>
                            <Button Content="Export CSV" HorizontalAlignment="Right"
                                    Command="{Binding ExportCsvCommand}" />
                        </StackPanel>

                        <controls:DataGrid Grid.Row="2" ItemsSource="{Binding QueryRows}"
                                            AutoGenerateColumns="False" IsReadOnly="True">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="Line" Binding="{Binding LineNo}" />
                                <controls:DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" />
                                <controls:DataGridTextColumn Header="Pod" Binding="{Binding PodName}" />
                                <controls:DataGridTemplateColumn Header="Severity">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Classes="SeverityBadge"
                                                    Background="{Binding Severity, Converter={StaticResource SeverityBrushConverter}}">
                                                <TextBlock Text="{Binding Severity}" />
                                            </Border>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>
                                <controls:DataGridTextColumn Header="Type" Binding="{Binding EventType}" />
                                <controls:DataGridTextColumn Header="Request ID" Binding="{Binding RequestId}" />
                                <controls:DataGridTextColumn Header="Target Service" Binding="{Binding TargetService}" />
                                <controls:DataGridTextColumn Header="Method" Binding="{Binding Method}" />
                                <controls:DataGridTextColumn Header="Path" Binding="{Binding Path}" />
                                <controls:DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" />
                                <controls:DataGridTextColumn Header="Duration" Binding="{Binding DurationMs}" />
                                <controls:DataGridTextColumn Header="Exception" Binding="{Binding ExceptionName}" />
                                <controls:DataGridTextColumn Header="Message" Binding="{Binding ExceptionMessage}" />
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
