<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:vm="using:LogAnalyzerClient.ViewModels"
                xmlns:models="using:LogAnalyzerClient.Models"
                xmlns:helpers="using:LogAnalyzerClient.Helpers"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                x:Class="LogAnalyzerClient.Views.MainView"
                x:DataType="vm:MainViewModel">
    <UserControl.Resources>
        <helpers:SeverityToBrushConverter x:Key="SeverityBrush" />
    </UserControl.Resources>
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File(_F)">
                <MenuItem Header="Connect...(_C)" Command="{Binding ConnectCommand}" />
                <MenuItem Header="Refresh(_R)" Command="{Binding RefreshCommand}" />
                <Separator />
                <MenuItem Header="Exit(_E)" Name="ExitMenuItem" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="About(_A)" Command="{Binding AboutCommand}" />
        </Menu>

        <Border DockPanel.Dock="Bottom"
                Padding="10"
                BorderThickness="1,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                <TextBlock Text="[Status] " />
                <TextBlock Text="{Binding ConnectStatus}" />
                <TextBlock Text="Agent address: " />
                <TextBlock Text="{Binding CurrentAddress}" />
                <TextBlock Text="; Current Directory: " />
                <TextBlock Text="{Binding DirectoryPath}" />
            </StackPanel>
        </Border>

        <Grid Margin="16" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Spacing="4"
            >
                <TextBlock Classes="TitleText" Text="LogAnalyzerClient" />
                <TextBlock Classes="SubtleText" Text="GUI remote client of LogAnalyzer." />
            </StackPanel>

            <Border
                Grid.Row="1"
                Grid.Column="0"
                Classes="Card"
            >
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5" RowSpacing="5">
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Directory Path" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding DirectoryPath, Mode=OneWayToSource}"
                             PlaceholderText="Input the directory path on the node" />
                    <Button Grid.Row="0" Grid.Column="2" Classes="SecondaryButton" Content="Change Directory" Command="{Binding ChangeDirectoryCommand}" />
                    <Button Grid.Row="0" Grid.Column="3" Classes="SecondaryButton" Content="Refresh" Command="{Binding RefreshCommand}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,10,0,10" ColumnSpacing="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MaxWidth="360" MinWidth="50" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Classes="Card">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="8">
                            <TextBlock Classes="SectionTitle" Text="Log Files" />
                            <TextBlock Classes="SubtleText" Text="Supports multiple selection (hold Ctrl). Right-click to view analysis results for the currently selected files." TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Margin="0,0,5,0" VerticalAlignment="Center" Text="DoP" />
                                <TextBox Name="DegreeTextBox"
                                         Grid.Column="1"
                                         Classes="NumericInput"
                                         Text="{Binding DegreeOfParallelismText}"
                                         PlaceholderText="Degree of Parallelism" />
                                <TextBlock Grid.Column="2" Margin="10,0,5,0" VerticalAlignment="Center" Text="Analyze" />
                                <Button Grid.Column="3" Content="Selected" Command="{Binding AnalyzeSelectedFilesCommand}" />
                                <Button Grid.Column="4" Margin="5,0,0,0" Content="All" Command="{Binding AnalyzeAllCommand}" />
                            </Grid>
                        </StackPanel>

                        <ListBox Name="LogFileListBox"
                                 Classes="FileList"
                                 Margin="0,12,0,0"
                                 ItemsSource="{Binding LogFiles, Mode=OneWay}"
                                 SelectedItem="{Binding SelectedLogFile, Mode=OneWayToSource}"
                                 SelectionMode="Multiple"
                                 SelectionChanged="LogFileListBox_SelectionChanged"
                                 >
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Analyze File(_A)" Command="{Binding AnalyzeRightClickedFileCommand}"/>
                                    <MenuItem Header="View Analysis Results(_V)" Command="{Binding GetAnalysisResultCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:LogFileItem">
                                    <TextBlock Text="{Binding FileName, Mode=OneWay}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Classes="Card">
                    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="SectionTitle" Text="Analysis Result" />
                            <TextBlock VerticalAlignment="Center" Text="Sort by:" />
                            <ComboBox Width="130"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding SortKeys}"
                                      SelectedItem="{Binding SortKey}" />
                            <CheckBox VerticalAlignment="Center"
                                      Content="Descending"
                                      IsChecked="{Binding SortDescending}" />
                            <Button Content="Apply Sort" Command="{Binding SortRowsCommand}" />
                            <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Classes="SubtleText"
                                       Text="Query conditions (leave blank / select All to skip):"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock VerticalAlignment="Center" Text="Request ID" />
                                <TextBox Width="150" Text="{Binding QueryRequestId}"
                                         PlaceholderText="Request ID" />
                                <TextBlock VerticalAlignment="Center" Text="Service" />
                                <TextBox Width="120" Text="{Binding QueryServiceName}"
                                         PlaceholderText="e.g. gateway" />
                                <TextBlock VerticalAlignment="Center" Text="Severity" />
                                <ComboBox Width="110"
                                          ItemsSource="{Binding SeverityFilterOptions}"
                                          SelectedItem="{Binding QuerySeverity}" />
                                <TextBlock VerticalAlignment="Center" Text="Event" />
                                <ComboBox Width="110"
                                          ItemsSource="{Binding EventTypeFilterOptions}"
                                          SelectedItem="{Binding QueryEventType}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock VerticalAlignment="Center" Text="Start time" />
                                <TextBox Width="190" Text="{Binding QueryStartTime}"
                                         PlaceholderText="2026-06-05T16:00:00Z" />
                                <TextBlock VerticalAlignment="Center" Text="End time" />
                                <TextBox Width="190" Text="{Binding QueryEndTime}"
                                         PlaceholderText="2026-06-05T17:00:00Z" />
                                <Button Content="Query" Command="{Binding QueryCommand}" />
                                <Button Content="Clear Filter" Command="{Binding ClearFilterCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   Text="{Binding ResultStatusText}"
                                   TextWrapping="Wrap" />

                        <DataGrid Grid.Row="3"
                                  ItemsSource="{Binding ResultRows, Mode=OneWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  CanUserSortColumns="False"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="LineNo" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:LogTableRow">
                                            <TextBlock Text="{Binding LineNo}" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Timestamp" Width="210">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:LogTableRow">
                                            <TextBlock Text="{Binding Timestamp}" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="PodName" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:LogTableRow">
                                            <TextBlock Text="{Binding PodName}" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Severity" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:LogTableRow">
                                            <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    Margin="2"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Severity}" Foreground="White" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="EventType" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:LogTableRow">
                                            <TextBlock Text="{Binding EventType}" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="RequestId" Width="250">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:LogTableRow">
                                            <TextBlock Text="{Binding RequestId}" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="TargetService" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:LogTableRow">
                                            <TextBlock Text="{Binding TargetService}" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="DurationMs" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:LogTableRow">
                                            <TextBlock Text="{Binding DurationMs}" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Method" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:LogTableRow">
                                            <TextBlock Text="{Binding Method}" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Path" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:LogTableRow">
                                            <TextBlock Text="{Binding Path}" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="StatusCode" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:LogTableRow">
                                            <TextBlock Text="{Binding StatusCode}" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ExceptionName" Width="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:LogTableRow">
                                            <TextBlock Text="{Binding ExceptionName}" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ExceptionMessage" Width="300">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:LogTableRow">
                                            <TextBlock Text="{Binding ExceptionMessage}" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
