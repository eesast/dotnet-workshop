<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:vm="using:LogAnalyzerClient.ViewModels"
                xmlns:models="using:LogAnalyzerClient.Models"
                xmlns:converters="using:LogAnalyzerClient.Converters"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                x:Class="LogAnalyzerClient.Views.MainView"
                x:DataType="vm:MainViewModel">
    <UserControl.Resources>
        <converters:SeverityToBrushConverter x:Key="SeverityToBrush" />
    </UserControl.Resources>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File(_F)">
                <MenuItem Header="Connect...(_C)" Command="{Binding ConnectCommand}" />
                <MenuItem Header="Refresh(_R)" Command="{Binding RefreshCommand}" />
                <MenuItem Header="Manage Tokens...(_M)"
                          Command="{Binding ManageTokensCommand}"
                          IsVisible="{Binding IsAdmin, Mode=OneWay}" />
                <Separator />
                <MenuItem Header="Exit(_E)" Name="ExitMenuItem" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="About(_A)" Command="{Binding AboutCommand}" />
        </Menu>

        <Border DockPanel.Dock="Bottom"
                Padding="10"
                BorderThickness="1,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                <TextBlock Text="[Status] " />
                <TextBlock Text="{Binding ConnectStatus}" />
                <TextBlock Text=" [Admin]"
                           Foreground="OrangeRed"
                           FontWeight="SemiBold"
                           IsVisible="{Binding IsAdmin, Mode=OneWay}" />
                <TextBlock Text="Agent address: " />
                <TextBlock Text="{Binding CurrentAddress}" />
                <TextBlock Text="; Current Directory: " />
                <TextBlock Text="{Binding DirectoryPath}" />
            </StackPanel>
        </Border>

        <Grid Margin="16" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Spacing="4"
            >
                <TextBlock Classes="TitleText" Text="LogAnalyzerClient" />
                <TextBlock Classes="SubtleText" Text="GUI remote client of LogAnalyzer." />
            </StackPanel>

            <Border
                Grid.Row="1"
                Grid.Column="0"
                Classes="Card"
            >
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5" RowSpacing="5">
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Directory Path" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding DirectoryPath, Mode=OneWayToSource}"
                             PlaceholderText="Input the directory path on the node" />
                    <Button Grid.Row="0" Grid.Column="2" Classes="SecondaryButton" Content="Change Directory" Command="{Binding ChangeDirectoryCommand}" />
                    <Button Grid.Row="0" Grid.Column="3" Classes="SecondaryButton" Content="Refresh" Command="{Binding RefreshCommand}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,10,0,10" ColumnSpacing="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MaxWidth="360" MinWidth="50" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Classes="Card">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="8">
                            <TextBlock Classes="SectionTitle" Text="Log Files" />
                            <TextBlock Classes="SubtleText" Text="Supports multiple selection (hold Ctrl). Right-click to view analysis results for the currently selected files." TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Margin="0,0,5,0" VerticalAlignment="Center" Text="DoP" />
                                <TextBox Name="DegreeTextBox"
                                         Grid.Column="1"
                                         Classes="NumericInput"
                                         Text="{Binding DegreeOfParallelismText}"
                                         PlaceholderText="Degree of Parallelism" />
                                <TextBlock Grid.Column="2" Margin="10,0,5,0" VerticalAlignment="Center" Text="Analyze" />
                                <Button Grid.Column="3" Content="Selected" Command="{Binding AnalyzeSelectedFilesCommand}" />
                                <Button Grid.Column="4" Margin="5,0,0,0" Content="All" Command="{Binding AnalyzeAllCommand}" />
                            </Grid>
                        </StackPanel>

                        <ListBox Name="LogFileListBox"
                                 Classes="FileList"
                                 Margin="0,12,0,0"
                                 ItemsSource="{Binding LogFiles, Mode=OneWay}"
                                 SelectedItem="{Binding SelectedLogFile, Mode=OneWayToSource}"
                                 SelectionMode="Multiple"
                                 SelectionChanged="LogFileListBox_SelectionChanged"
                                 >
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Analyze File(_A)" Command="{Binding AnalyzeRightClickedFileCommand}"/>
                                    <MenuItem Header="View Analysis Results(_V)" Command="{Binding GetAnalysisResultCommand}" />
                                    <MenuItem Header="Show Call Topology(_T)" Command="{Binding ShowTopologyCommand}" />
                                    <MenuItem Header="Export to Parquet(_P)" Command="{Binding ExportCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:LogFileItem">
                                    <TextBlock Text="{Binding FileName, Mode=OneWay}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Classes="Card">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="5">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Column="0" Classes="SectionTitle" VerticalAlignment="Center" Text="Analysis Result" />
                            <Button Grid.Column="2"
                                    Classes="SecondaryButton"
                                    Content="Query..."
                                    Command="{Binding QueryCommand}" />
                            <Button Grid.Column="3"
                                    Margin="5,0,0,0"
                                    Classes="SecondaryButton"
                                    Content="Show All"
                                    IsVisible="{Binding IsResultFiltered, Mode=OneWay}"
                                    Command="{Binding GetAnalysisResultCommand}" />
                            <TextBlock Grid.Column="4" Margin="10,0,5,0" VerticalAlignment="Center" Text="Sort by" />
                            <ComboBox Grid.Column="5"
                                      MinWidth="130"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding SortKeys, Mode=OneWay}"
                                      SelectedItem="{Binding SelectedSortKey, Mode=TwoWay}" />
                            <CheckBox Grid.Column="6"
                                      Margin="10,0,0,0"
                                      VerticalAlignment="Center"
                                      Content="Descending"
                                      IsChecked="{Binding IsSortDescending, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Classes="SubtleText"
                                   Text="Analysis results shown as a table; the Severity cell is color-coded (Info = blue, Warning = orange, Error = red)."
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2"
                                   Classes="SubtleText"
                                   Text="Tip: use Query... to filter by event type / severity / service / request id / time range; change the sort key / direction to re-sort."
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="3"
                                   Classes="SubtleText"
                                   FontWeight="SemiBold"
                                   Text="{Binding ResultStatusText, Mode=OneWay}" />

                        <DataGrid Name="ResultEntryGrid"
                                  Grid.Row="4"
                                  ItemsSource="{Binding ResultEntries, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedResultEntry, Mode=OneWayToSource}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="False"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="View Trace for this Request(_R)" Command="{Binding ShowTraceCommand}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding LineNo}" />
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" />
                                <DataGridTemplateColumn Header="Severity">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:LogEntryRowVm">
                                            <Border CornerRadius="6"
                                                    Padding="8,2"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                                                <TextBlock Text="{Binding Severity}"
                                                           Foreground="White"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Service" Binding="{Binding Service}" />
                                <DataGridTextColumn Header="Type" Binding="{Binding EventType}" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
