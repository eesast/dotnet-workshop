<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:LogAnalyzerClient.Models"
        mc:Ignorable="d"
        x:Class="LogAnalyzerClient.TokenManagerWindow"
        d:DesignWidth="720" d:DesignHeight="560"
        Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        Title="Token Management (Admin)">
    <DockPanel Margin="15">

        <!-- 顶部：标题与刷新 -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="DialogTitle" Text="Issued Tokens" />
            <Button Grid.Column="1" Classes="SecondaryButton" Content="Refresh" Click="RefreshButton_Click" />
        </Grid>

        <!-- 创建新 token -->
        <Border DockPanel.Dock="Top"
                Classes="Card"
                Margin="0,10,0,10">
            <Grid RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Classes="SectionTitle" Text="Create new token" />
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Role" />
                    <ComboBox Grid.Column="1" Name="RoleComboBox" MinWidth="120" SelectedIndex="0">
                        <ComboBoxItem Content="Normal" />
                        <ComboBoxItem Content="Admin" />
                    </ComboBox>
                    <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Text="Note" />
                    <TextBox Grid.Column="3" Name="NoteTextBox" MinWidth="220" PlaceholderText="optional, e.g. for-alice" />
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Classes="PrimaryButton" Content="Create" Click="CreateButton_Click" />
                    <TextBlock Classes="SubtleText" VerticalAlignment="Center"
                               Text="The new token will be shown once; copy it and hand it to the user." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 状态 / 错误提示 -->
        <TextBlock DockPanel.Dock="Top"
                   Name="StatusTextBlock"
                   Classes="SubtleText"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <!-- token 列表 -->
        <Border BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                CornerRadius="6"
                Margin="0,4,0,0">
            <ScrollViewer>
                <ItemsControl Name="TokenListControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:TokenRowVm">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                  ColumnSpacing="8"
                                  Margin="6"
                                  Background="{Binding RowBackground, Mode=OneWay}">
                                <!-- token 与备注（可手动选中复制） -->
                                <StackPanel Grid.Column="0" Margin="6,4,6,4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="YOU"
                                                   IsVisible="{Binding IsSelf, Mode=OneWay}"
                                                   FontWeight="Bold"
                                                   Foreground="OrangeRed" />
                                        <TextBlock Text="{Binding Token, Mode=OneWay}"
                                                   FontFamily="Cascadia Mono,Consolas,Courier New"
                                                   TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBlock Classes="SubtleText"
                                               Text="{Binding Note, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- 角色徽标 -->
                                <Border Grid.Column="1"
                                        VerticalAlignment="Center"
                                        CornerRadius="8"
                                        Padding="8,2"
                                        Background="{Binding BadgeBrush, Mode=OneWay}">
                                    <TextBlock Text="{Binding RoleDisplay, Mode=OneWay}"
                                               Foreground="White"
                                               FontWeight="SemiBold" />
                                </Border>

                                <Button Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Content="{Binding ToggleLabel, Mode=OneWay}"
                                        Click="ToggleRoleButton_Click"
                                        Tag="{Binding .}" />
                                <Button Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Classes="SecondaryButton"
                                        Content="Delete"
                                        Click="DeleteButton_Click"
                                        Tag="{Binding Token, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
