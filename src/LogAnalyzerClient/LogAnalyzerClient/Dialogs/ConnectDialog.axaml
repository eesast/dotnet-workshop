<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="LogAnalyzerClient.ConnectDialog"
        d:DesignWidth="480" d:DesignHeight="260"
        Width="480" Height="280"
        CanResize="False" WindowStartupLocation="CenterOwner"
        Title="Connect...">
    <StackPanel Margin="15" Spacing="8">
        <TextBlock Text="Agent address:" />
        <TextBox Name="AddressTextBox"
                 PlaceholderText="e.g. http://localhost:5000" />

        <TextBlock Text="Token (printed in the Agent console on startup):" />
        <TextBox Name="TokenTextBox"
                 PlaceholderText="paste the admin token here" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="5"
                    Margin="0,6,0,0">
            <Button Classes="PrimaryButton"
                    Content="Connect"
                    IsDefault="True"
                    Click="ConnectButton_Click" />
            <Button Classes="SecondaryButton"
                    Content="Cancel"
                    Click="CancelButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
