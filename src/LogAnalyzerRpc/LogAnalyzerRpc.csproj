<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

 <ItemGroup>
    <!-- 将版本统一升级到较新的 3.35.1 和 2.83.0，与 LocalCli 保持一致 -->
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Core.Api" Version="2.70.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogAnalyzer\LogAnalyzer.csproj" />
    <ProjectReference Include="..\LogParser\LogParser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\log_analyzer.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
